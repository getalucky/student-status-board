{
  "name": "student-status-board",
  "version": "1.2.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "学生状态管理系统 · 单账号看板 + 反馈记录 + 家长反馈流式生成",
  "engines": {
    "node": ">=22"
  },
  "main": "server/index.js",
  "scripts": {
    "build": "vite build --config web/vite.config.ts",
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "init": "node scripts/init.js",
    "backup": "node scripts/backup.js --keep 7",
    "package": "powershell -ExecutionPolicy Bypass -File scripts/package-release.ps1",
    "test:release": "powershell -ExecutionPolicy Bypass -File deploy/self-test.ps1",
    "test": "node --test --test-concurrency=1 \"tests/*.test.js\"",
    "test:watch": "node --test --watch \"tests/*.test.js\""
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^8.2.0",
    "@node-rs/argon2": "^2.0.2",
    "better-sqlite3": "^13.0.0",
    "fastify": "^5.6.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@types/sortablejs": "^1.15.9",
    "@vitejs/plugin-vue": "^6.0.1",
    "element-plus": "^2.11.4",
    "pinia": "^3.0.3",
    "sortablejs": "^1.15.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vue": "^3.5.22",
    "vue-router": "^4.5.1",
    "vue-tsc": "^3.1.1"
  }
}
