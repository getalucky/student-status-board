<?xml version="1.0" encoding="utf-8"?>
<!--
  只信任系统 CA：不打包用户证书，不信任自签，不允许明文。
  Tailscale 的 ts.net 证书由 Let's Encrypt 签发，走系统根即可通过校验。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
